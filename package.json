{
  "name": "taskora",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter @taskora/shared build && pnpm --filter @taskora/engine build && pnpm --filter @taskora/backend exec prisma generate && pnpm -r --parallel --config.enable-pre-post-scripts=false run test",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.0"
  }
}
