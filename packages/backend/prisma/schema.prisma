generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  displayName     String?
  avatarUrl       String?
  preferences     Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tasks           Task[]
  projects        Project[]
  areas           Area[]
  tags            Tag[]
  tagGroups       TagGroup[]
  projectHeadings ProjectHeading[]
  refreshTokens   RefreshToken[]
  agentConfig     AgentConfig?
  conversations   Conversation[]
  devices         Device[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model Area {
  id        String    @id @default(uuid())
  title     String
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects  Project[]
  tasks     Task[]
  tags      AreaTag[]

  sortOrder Int @default(0)

  @@index([userId])  /// 字段级 LWW 时钟（ADR-0007）：{field: "hlc:deviceId"}。
  fieldClocks Json?
  /// 字段值摘要（ADR-0007）：REST 写绕过合并器时用于判定哪个字段被改动、只重置该字段的时钟。
  fieldDigests Json?

}

enum ProjectStatus {
  ACTIVE
  COMPLETED
}

enum ProjectBucket {
  INBOX
  ANYTIME
  SCHEDULED
}

model Project {
  id        String           @id @default(uuid())
  title     String
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  areaId    String?
  area      Area?            @relation(fields: [areaId], references: [id], onDelete: SetNull)
  tasks     Task[]
  headings  ProjectHeading[]

  sortOrder Int @default(0)

  status        ProjectStatus @default(ACTIVE)
  bucket        ProjectBucket @default(ANYTIME)
  scheduledType ScheduledType @default(NONE)
  scheduledDate DateTime?
  dueDate       DateTime?
  completedAt   DateTime?
  trashedAt     DateTime?

  tags ProjectTag[]

  @@index([userId])
  @@index([areaId])  /// 字段级 LWW 时钟（ADR-0007）：{field: "hlc:deviceId"}。
  fieldClocks Json?
  /// Position：fractional indexing 排序位次（local-first，ADR-0007）；过渡期与 sortOrder 并存。
  position String?
  /// 字段值摘要（ADR-0007）：REST 写绕过合并器时用于判定哪个字段被改动、只重置该字段的时钟。
  fieldDigests Json?

}

model AreaTag {
  id        String   @id @default(uuid())
  areaId    String
  area      Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([areaId, tagId])
  @@index([areaId])
  @@index([tagId])
}

model ProjectTag {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, tagId])
  @@index([projectId])
  @@index([tagId])
}

enum TaskStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TaskBucket {
  INBOX
  ANYTIME
  SCHEDULED
}

enum ScheduledType {
  NONE
  DATE
  SOMEDAY
}

enum HeadingStatus {
  ACTIVE
  COMPLETED
}

model TagGroup {
  id        String   @id @default(uuid())
  title     String
  sortOrder Int      @default(0)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags      Tag[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])  /// 字段级 LWW 时钟（ADR-0007）：{field: "hlc:deviceId"}。
  fieldClocks Json?
  /// 字段值摘要（ADR-0007）：REST 写绕过合并器时用于判定哪个字段被改动、只重置该字段的时钟。
  fieldDigests Json?

}

model Tag {
  id         String       @id @default(uuid())
  title      String
  color      String       @default("#3B82F6")
  sortOrder  Int          @default(0)
  tagGroupId String?
  tagGroup   TagGroup?    @relation(fields: [tagGroupId], references: [id], onDelete: SetNull)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks      TaskTag[]
  projects   ProjectTag[]
  areas      AreaTag[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([userId])
  @@index([tagGroupId])  /// 字段级 LWW 时钟（ADR-0007）：{field: "hlc:deviceId"}。
  fieldClocks Json?
  /// Position：fractional indexing 排序位次（local-first，ADR-0007）；过渡期与 sortOrder 并存。
  position String?
  /// 字段值摘要（ADR-0007）：REST 写绕过合并器时用于判定哪个字段被改动、只重置该字段的时钟。
  fieldDigests Json?

}

model TaskTag {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([taskId, tagId])
  @@index([taskId])
  @@index([tagId])
}

model Task {
  id            String        @id @default(uuid())
  title         String
  notes         String?
  scheduledDate DateTime?
  dueDate       DateTime?
  reminderTime  String?
  /// Repeat Rule（recurring-tasks spec）：规范形规则对象的 JSON 文本
  /// （unit/interval/weekdays/anchor/until）。仅 DATE 型任务携带。
  repeatRule    String?
  bucket        TaskBucket    @default(INBOX)
  scheduledType ScheduledType @default(NONE)
  status        TaskStatus    @default(ACTIVE)
  settledAt     DateTime?
  trashedAt     DateTime?
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subtasks Subtask[]

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  headingId String?
  heading   ProjectHeading? @relation(fields: [headingId], references: [id], onDelete: SetNull)

  areaId String?
  area   Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)

  tags TaskTag[]

  @@index([userId])
  @@index([projectId])
  @@index([headingId])
  @@index([areaId])  /// 字段级 LWW 时钟（ADR-0007）：{field: "hlc:deviceId"}。
  fieldClocks Json?
  /// Position：fractional indexing 排序位次（local-first，ADR-0007）；过渡期与 sortOrder 并存。
  position String?
  /// 字段值摘要（ADR-0007）：REST 写绕过合并器时用于判定哪个字段被改动、只重置该字段的时钟。
  fieldDigests Json?

}

model Subtask {
  id          String     @id @default(uuid())
  title       String
  status      TaskStatus @default(ACTIVE)
  settledAt   DateTime?
  sortOrder   Int        @default(0)
  taskId      String
  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([taskId])  /// 字段级 LWW 时钟（ADR-0007）：{field: "hlc:deviceId"}。
  fieldClocks Json?
  /// 字段值摘要（ADR-0007）：REST 写绕过合并器时用于判定哪个字段被改动、只重置该字段的时钟。
  fieldDigests Json?

}

model ProjectHeading {
  id          String        @id @default(uuid())
  title       String
  sortOrder   Int           @default(0)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]
  status      HeadingStatus @default(ACTIVE)
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([projectId])  /// 字段级 LWW 时钟（ADR-0007）：{field: "hlc:deviceId"}。
  fieldClocks Json?
  /// 字段值摘要（ADR-0007）：REST 写绕过合并器时用于判定哪个字段被改动、只重置该字段的时钟。
  fieldDigests Json?

}

/// BYOK configuration for the conversational Assistant (see ADR 0003).
/// One row per user; the API key is AES-256-GCM encrypted at rest.
model AgentConfig {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String   @default("custom")
  baseUrl         String?
  apiKeyEncrypted String?
  modelId         String?
  /// Thinking effort requested from the model: off / low / medium / high.
  thinkingLevel   String   @default("off")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// A persisted conversation between the user and the Assistant.
model Conversation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  ConversationMessage[]
  approvals AgentApproval[]

  @@index([userId])
}

/// One serialized pi-agent-core AgentMessage, in order (seq).
model ConversationMessage {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  seq            Int
  message        Json
  createdAt      DateTime     @default(now())

  @@unique([conversationId, seq])
}

/// A destructive tool call intercepted by beforeToolCall, pending user decision.
model AgentApproval {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolCallId     String
  toolName       String
  args           Json
  /// id → entity title, so the approval card shows names, not database ids.
  labels         Json?        @default("{}")
  status         String       @default("pending") // pending | approved | rejected | expired
  createdAt      DateTime     @default(now())
  resolvedAt     DateTime?

  @@unique([toolCallId])
  @@index([conversationId])
}

/// 登录设备（ADR-0007）：device id 在登录时分配、持久保存于 Local Replica；
/// 登出保留本地数据，重新登录分配新 device id。
model Device {
  id        String   @id @default(uuid())
  deviceId  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@unique([userId, deviceId])
  @@index([userId])
}

/// Compact 登记（ADR-0008）：已被物理删除（Delete Request / hub GC）的
/// 实体 id。迟到的设备字段写到达这些实体时被静默丢弃（Compact 永久
/// 获胜，副本与 hub 同规则）。这不是墓碑：不承载值与时钟，仅登记
/// 「该 id 已不存在，拒绝重建」。
model CompactedEntity {
  id        String   @id @default(uuid())
  userId    String
  entity    String
  entityId  String
  createdAt DateTime @default(now())

  @@unique([userId, entity, entityId])
  @@index([userId])
}
