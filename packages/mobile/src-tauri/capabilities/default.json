{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the Android main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "statusbar:default",
    "reminders:default",
    "background:default",
    "attachments:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/MaplumeX/Taskora/releases/download/*"
        }
      ]
    }
  ]
}
