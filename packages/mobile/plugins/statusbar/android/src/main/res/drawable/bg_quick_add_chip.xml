<?xml version="1.0" encoding="utf-8"?>
<!-- 快速添加浮层的 chip（日期 / 归属 / Tag / 连续添加）：选中时强调色底，未选描边。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/quick_add_chip_selected_bg" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/quick_add_chip_stroke" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
