<?xml version="1.0" encoding="utf-8"?>
<!--
    快速添加浮层（QuickAddActivity）：原生只画遮罩，卡片是透明 WebView 里
    与桌面同一张 QuickAddCard（packages/mobile/src/quick-add）。WebView 的
    上下边距随状态栏与键盘调整（见 QuickAddActivity.applyInsets）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_add_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 遮罩单独一层，便于和卡片分别做淡入淡出；点击即关闭。 -->
    <View
        android:id="@+id/quick_add_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/quick_add_scrim" />

    <WebView
        android:id="@+id/quick_add_web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />
</FrameLayout>
