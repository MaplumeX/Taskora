<?xml version="1.0" encoding="utf-8"?>
<!-- 快速添加浮层（QuickAddActivity）：顶部卡片式输入框，半透明透出下层。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_add_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/quick_add_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="96dp"
        android:background="@drawable/bg_quick_add_card"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <EditText
            android:id="@+id/quick_add_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@android:color/transparent"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="text|textCapSentences"
            android:minHeight="48dp"
            android:textColor="@color/quick_add_text"
            android:textColorHint="@color/quick_add_text_hint"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/quick_add_submit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:textColor="@color/quick_add_accent"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
