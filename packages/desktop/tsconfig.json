{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "useDefineForClassFields": true,
    "isolatedModules": true,
    "types": ["vitest/globals"],
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/components/*": ["../ui/src/components/*"],
      "@/lib/utils": ["../ui/src/lib/utils"],
      "@/*": ["./src/*"],
      "@taskora/ui": ["../ui/src/index.ts"],
      "@taskora/ui/*": ["../ui/src/*"],
      "@/api/*": ["../api/src/api/*"],
      "@/events/*": ["../api/src/events/*"],
      "@/hooks/*": ["../api/src/hooks/*"],
      "@/stores/*": ["../api/src/stores/*"],
      "@/utils/*": ["../api/src/utils/*"],
      "@/token-store": ["../api/src/token-store"],
      "@/i18n/config": ["../api/src/i18n/config"]
    }
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts", "tailwind.config.js", "postcss.config.js"]
}
