# Docker Compose environment file.
# Copy this file to the repository root as .env before starting Compose.

POSTGRES_USER=taskora
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=taskora

# Host-side ports. The container ports stay unchanged.
POSTGRES_PORT=5432
BACKEND_PORT=3000
FRONTEND_PORT=8080

# Use a long random value in any shared or production environment.
JWT_SECRET=change-me-to-a-long-random-secret
NODE_ENV=development

# The SPA is served by nginx and proxies /api to the backend service.
VITE_API_URL=/api/v1
